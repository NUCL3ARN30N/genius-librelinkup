[Unit]
Description=Genius LibreLinkUp caching server
Documentation=https://github.com/NUCL3ARN30N/genius-librelinkup
After=network-online.target
Wants=network-online.target

[Service]
User=gllu
Group=gllu
EnvironmentFile=/etc/gllu-server.env
Environment=GLLU_DATA_DIR=/var/lib/gllu-server
ExecStart=/usr/local/bin/gllu-server serve
Restart=always
RestartSec=10
UMask=0077
StateDirectory=gllu-server
StateDirectoryMode=0700

# sandbox: the service can only write its state directory and only open network sockets
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# port 8443 does not need CAP_NET_BIND_SERVICE; use a port above 1024

[Install]
WantedBy=multi-user.target
