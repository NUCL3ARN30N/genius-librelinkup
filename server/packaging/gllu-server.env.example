# /etc/gllu-server.env  (chmod 600 – contains your LibreLinkUp password)
LLU_EMAIL=you@example.com
LLU_PASSWORD=change-me
# address the desktop apps use to reach this server (put into pairing codes)
GLLU_PUBLIC_URL=https://192.168.1.20:8443
# names/IPs written into the self-signed certificate
GLLU_TLS_SANS=192.168.1.20,gllu.lan
GLLU_LISTEN=0.0.0.0:8443
GLLU_NAME=Home server
# only these networks may connect (recommended; comma separated, e.g. LAN + VPN)
GLLU_ALLOW_CIDRS=192.168.0.0/16,10.0.0.0/8,100.64.0.0/10,fd00::/8
# encrypt the stored readings at rest (recommended)
#GLLU_DATA_PASSPHRASE=
# optional: force a LibreLinkUp region
#LLU_SERVER=https://api-eu2.libreview.io
# time zone of the email reports (default: the system's)
#TZ=Europe/Vienna
# optional email reports with the PDF attached (see the server README)
#GLLU_SMTP_URL=smtps://reports@example.com@mail.example.com:465
#GLLU_SMTP_PASSWORD=
#GLLU_REPORT_FROM=Glucose reports <reports@example.com>
#GLLU_REPORT_TO=me@example.com,doctor@example.com
# any of daily,weekly,monthly
#GLLU_REPORT_SCHEDULE=monthly
#GLLU_REPORT_TIME=07:00
# PDF inside an AES-256 ZIP; the email then contains no glucose values
#GLLU_REPORT_ZIP_PASSWORD=
# target range in mg/dL and units (default: as set in LibreLinkUp)
#GLLU_TARGET_LOW=70
#GLLU_TARGET_HIGH=180
#GLLU_UNITS=mmol
#GLLU_LANG=en
