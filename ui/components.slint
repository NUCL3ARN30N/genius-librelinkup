import { Theme, Icons, Toast } from "theme.slint";

export struct StatItem {
    label: string,
    value: string,
    hint: string,
}

export component Icon inherits Rectangle {
    in property <string> path;
    in property <color> tint: Theme.on-surface-variant;
    width: 24px;
    height: 24px;
    Path {
        width: 100%;
        height: 100%;
        commands: root.path;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        stroke-width: 0px;
    }
}

// The application icon as a vector: red drop with a white pulse line. Stays brand red, it does
// not follow the (customisable) range colours.
export component AppLogo inherits Rectangle {
    width: 32px;
    height: 32px;
    Path {
        width: 100%;
        height: 100%;
        commands: Icons.drop;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #d32f2f;
        stroke-width: 0px;
    }
    Path {
        width: 100%;
        height: 100%;
        commands: Icons.pulse;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: #ffffff;
        stroke-width: root.width * 0.07;
        stroke-line-cap: round;
    }
}

export component Card inherits Rectangle {
    in property <color> tone: Theme.surface-container;
    background: tone;
    border-radius: Theme.radius-l;
}

export component Title inherits Text {
    color: Theme.on-surface;
    font-size: 16px;
    font-weight: 600;
}

export component Caption inherits Text {
    color: Theme.on-surface-variant;
    font-size: 12px;
    wrap: word-wrap;
}

// Material 3 button. kind: 0 filled, 1 tonal, 2 outlined, 3 text, 4 filled destructive
export component MButton inherits Rectangle {
    in property <string> text;
    in property <int> kind: 1;
    in property <bool> enabled: true;
    in property <string> icon;
    callback clicked;

    property <color> fill: kind == 0 ? Theme.primary : kind == 1 ? Theme.primary-container : kind == 4 ? Theme.error : transparent;
    property <color> ink: kind == 0 ? Theme.on-primary : kind == 1 ? Theme.on-primary-container : kind == 4 ? Theme.on-error : Theme.primary;

    height: 40px;
    min-width: 64px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: min(self.height / 2, Theme.radius-pill);
    background: !enabled ? (kind <= 1 || kind == 4 ? Theme.on-surface.with-alpha(0.12) : transparent) : fill;
    border-width: kind == 2 ? 1px : 0px;
    border-color: enabled ? Theme.outline : Theme.on-surface.with-alpha(0.12);

    // state layer
    Rectangle {
        border-radius: parent.border-radius;
        background: root.ink.with-alpha(!root.enabled ? 0 : touch.pressed ? 0.14 : touch.has-hover ? 0.08 : 0);
        animate background { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: root.icon != "" ? 16px : 24px;
        padding-right: 24px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            path: root.icon;
            tint: root.enabled ? root.ink : Theme.on-surface.with-alpha(0.38);
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: 600;
            color: root.enabled ? root.ink : Theme.on-surface.with-alpha(0.38);
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Segmented button row (single choice).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    height: 40px;
    border-radius: min(self.height / 2, Theme.radius-pill);
    border-width: 1px;
    border-color: Theme.outline;
    clip: true;
    HorizontalLayout {
        for opt[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            min-width: 56px;
            background: i == root.selected ? Theme.primary-container : (ta.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent);
            animate background { duration: 120ms; }
            if i > 0: Rectangle {
                x: 0;
                width: 1px;
                background: Theme.outline;
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;
                if i == root.selected: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    path: Icons.check;
                    tint: Theme.on-primary-container;
                }
                Text {
                    text: opt;
                    vertical-alignment: center;
                    font-size: 13px;
                    font-weight: 600;
                    color: i == root.selected ? Theme.on-primary-container : Theme.on-surface;
                    overflow: elide;
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component MSwitch inherits Rectangle {
    in property <string> text;
    in property <string> supporting;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: 40px;
    opacity: enabled ? 1 : 0.45;
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                color: Theme.on-surface;
                font-size: 14px;
                wrap: word-wrap;
            }
            if root.supporting != "": Caption { text: root.supporting; }
        }
        Rectangle {
            width: 52px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: root.checked ? Theme.primary : Theme.surface-container-high;
            border-width: root.checked ? 0px : 2px;
            border-color: Theme.outline;
            animate background { duration: 150ms; }
            thumb := Rectangle {
                property <length> size: root.checked ? 24px : 16px;
                width: self.size;
                height: self.size;
                x: root.checked ? parent.width - self.size - 4px : 8px;
                y: (parent.height - self.size) / 2;
                border-radius: self.size / 2;
                background: root.checked ? Theme.on-primary : Theme.outline;
                animate x, width, height { duration: 150ms; easing: ease-out; }
            }
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Outlined text field with a label above it.
export component TextField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <string> suffix;
    callback edited(string);
    callback accepted(string);
    public function focus-input() { input.focus(); }
    spacing: 4px;
    if root.label != "": Caption { text: root.label; }
    Rectangle {
        height: 44px;
        border-radius: Theme.radius-m;
        border-width: input.has-focus ? 2px : 1px;
        border-color: !root.enabled ? Theme.outline-variant : input.has-focus ? Theme.primary : Theme.outline;
        background: Theme.surface.with-alpha(Theme.dark ? 0.4 : 1);
        opacity: root.enabled ? 1 : 0.55;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                input := TextInput {
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                    color: Theme.on-surface;
                    selection-background-color: Theme.primary.with-alpha(0.35);
                    selection-foreground-color: Theme.on-surface;
                    font-size: 14px;
                    enabled: root.enabled;
                    input-type: root.input-type;
                    single-line: true;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                }
                if input.text == "": Text {
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.placeholder;
                    color: Theme.on-surface-variant.with-alpha(0.7);
                    font-size: 14px;
                }
            }
            if root.suffix != "": Text {
                text: root.suffix;
                vertical-alignment: center;
                color: Theme.on-surface-variant;
                font-size: 13px;
            }
        }
    }
}

component RoundIconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: ta.pressed ? Theme.on-surface.with-alpha(0.14) : ta.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent;
    opacity: enabled ? 1 : 0.35;
    Icon {
        width: 18px;
        height: 18px;
        path: root.icon;
        tint: Theme.on-surface;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Number input with −/+ buttons.
export component Stepper inherits VerticalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> suffix;
    in property <bool> enabled: true;
    spacing: 4px;
    if root.label != "": Caption { text: root.label; }
    Rectangle {
        height: 44px;
        border-radius: Theme.radius-m;
        border-width: 1px;
        border-color: root.enabled ? Theme.outline : Theme.outline-variant;
        opacity: root.enabled ? 1 : 0.55;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            RoundIconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.minus;
                enabled: root.enabled && root.value > root.minimum;
                clicked => { root.value = max(root.minimum, root.value - root.step); }
            }
            Text {
                horizontal-stretch: 1;
                text: root.value + (root.suffix != "" ? " " + root.suffix : "");
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.on-surface;
                font-size: 14px;
                font-weight: 600;
            }
            RoundIconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.plus;
                enabled: root.enabled && root.value < root.maximum;
                clicked => { root.value = min(root.maximum, root.value + root.step); }
            }
        }
    }
}

export component Swatch inherits Rectangle {
    in property <color> fill;
    in property <bool> selected;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: fill;
    border-width: selected ? 3px : 1px;
    border-color: selected ? Theme.on-surface : Theme.outline-variant;
    if root.selected: Icon {
        width: 16px;
        height: 16px;
        path: Icons.check;
        tint: #ffffff;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    width: 80px;
    height: 64px;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: min(16px, Theme.radius-pill);
                background: root.selected ? Theme.primary-container : (touch.has-hover ? Theme.surface-container-high : transparent);
                animate background { duration: 150ms; }
                Icon {
                    path: root.icon;
                    tint: root.selected ? Theme.on-primary-container : Theme.on-surface-variant;
                }
            }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.on-surface : Theme.on-surface-variant;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: touch.pressed ? Theme.surface-container-high : (touch.has-hover ? Theme.surface-container : transparent);
    opacity: enabled ? 1 : 0.4;
    Icon {
        path: root.icon;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component StatTile inherits Rectangle {
    in property <StatItem> item;
    min-width: 110px;
    VerticalLayout {
        spacing: 2px;
        Caption { text: root.item.label; }
        Text {
            text: root.item.value;
            color: Theme.on-surface;
            font-size: 22px;
            font-weight: 600;
        }
        if root.item.hint != "": Caption { text: root.item.hint; }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    height: 32px;
    border-radius: min(8px, Theme.radius-pill);
    background: error ? Theme.error-container : transparent;
    border-width: error ? 0px : 1px;
    border-color: Theme.outline-variant;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 12px;
            font-weight: 500;
            color: root.error ? Theme.on-error-container : Theme.on-surface-variant;
        }
    }
}

export component Banner inherits Rectangle {
    in property <string> text;
    background: Theme.error-container;
    border-radius: Theme.radius-m;
    HorizontalLayout {
        padding: 12px;
        Text {
            text: root.text;
            color: Theme.on-error-container;
            wrap: word-wrap;
        }
    }
}

// Bottom snackbar for Toast.message; hides itself after a few seconds.
export component Snackbar inherits Rectangle {
    visible: Toast.message != "";
    height: 48px;
    width: min(560px, max(240px, label.preferred-width + 72px));
    border-radius: min(Theme.radius-s, 8px);
    background: Theme.inverse-surface;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        label := Text {
            horizontal-stretch: 1;
            text: Toast.message;
            vertical-alignment: center;
            color: Theme.inverse-on-surface;
            font-size: 14px;
            overflow: elide;
        }
        Rectangle {
            width: 40px;
            Icon {
                width: 18px;
                height: 18px;
                path: Icons.close;
                tint: Theme.inverse-on-surface;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Toast.message = ""; }
            }
        }
    }
    Timer {
        interval: 3500ms;
        running: Toast.message != "";
        triggered => { Toast.message = ""; }
    }
}
