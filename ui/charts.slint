import { Theme } from "theme.slint";
import { Caption } from "components.slint";

// All chart geometry is computed in Rust. Paths use a 1000×400 viewbox; positions are
// fractions (0..1) of the plot area, measured from the left / top.
export struct AxisLabel {
    pos: float,
    text: string,
}

export struct Dot {
    x: float,
    y: float,
    level: int,
}

// A reading the pointer can hover: position as above, plus the texts for the tooltip. `when`
// is the time in the note dialog's format ("2026-10-29 14:30"), empty where notes can't be added.
export struct GraphPoint {
    x: float,
    y: float,
    time: string,
    value: string,
    level: int,
    when: string,
}

export struct NoteMark {
    x: float,
    id: string,
    time: string,
    when: string,
    text: string,
}

// Lookups for hovering; implemented in Rust (binary search over the sorted x positions).
export global ChartBridge {
    // index of the entry nearest to `x` if it is at most `max-dx` away, else -1 (all fractions
    // of the plot width)
    pure callback nearest-point([GraphPoint], float, float) -> int;
    pure callback nearest-note([NoteMark], float, float) -> int;
}

// Tooltip for a hovered reading and/or note.
component HoverTip inherits Rectangle {
    in property <string> time;
    in property <string> value;
    in property <int> level;
    in property <string> note;
    width: root.note != "" ? max(200px, min(260px, row.preferred-width + 16px)) : layout.preferred-width;
    height: layout.preferred-height;
    border-radius: 8px;
    background: Theme.inverse-surface;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 1px;
    layout := VerticalLayout {
        padding: 8px;
        spacing: 4px;
        row := HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: root.time;
                color: Theme.inverse-on-surface.with-alpha(0.8);
                font-size: 12px;
                vertical-alignment: center;
            }
            if root.value != "": Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Theme.level-color(root.level);
            }
            if root.value != "": Text {
                text: root.value;
                color: Theme.inverse-on-surface;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        if root.note != "": Text {
            text: root.note;
            color: Theme.inverse-on-surface;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

export struct TirRow {
    label: string,
    range: string,
    pct: float,
    pct-text: string,
    duration: string,
    level: int,
}

export struct Insight {
    label: string,
    low: int,
    median: int,
    variability: int,
}

// One cell of the daily-profile calendar (Monday first). `key` identifies the local date and is
// -1 for the padding cells before the first and after the last day.
export struct DayCard {
    key: int,
    day: string,
    month: string,
    path: string,
    has-data: bool,
    in-range: string,
    level: int,
    points: [GraphPoint],
    notes: [NoteMark],
}

component PlotFrame inherits Rectangle {
    in property <[AxisLabel]> y-labels;
    in property <[AxisLabel]> x-labels;
    in property <float> band-top;
    in property <float> band-bottom;
    in property <length> left-pad: 44px;
    in property <length> bottom-pad: 24px;
    out property <length> plot-width: plot.width;
    out property <length> plot-height: plot.height;

    for l in root.y-labels: Text {
        x: 0;
        y: plot.y + plot.height * l.pos - 8px;
        width: root.left-pad - 8px;
        height: 16px;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: l.text;
        font-size: 11px;
        color: Theme.on-surface-variant;
    }
    for l in root.x-labels: Text {
        x: plot.x + plot.width * l.pos - 30px;
        y: plot.y + plot.height + 4px;
        width: 60px;
        horizontal-alignment: center;
        text: l.text;
        font-size: 11px;
        color: Theme.on-surface-variant;
    }

    plot := Rectangle {
        x: root.left-pad;
        y: 8px;
        width: root.width - root.left-pad - 12px;
        height: root.height - root.bottom-pad - 8px;
        clip: true;

        Rectangle {
            y: parent.height * root.band-top;
            height: parent.height * (root.band-bottom - root.band-top);
            background: Theme.target-band;
        }
        for l in root.y-labels: Rectangle {
            y: parent.height * l.pos;
            height: 1px;
            background: Theme.grid;
        }
        for l in root.x-labels: Rectangle {
            x: parent.width * l.pos;
            width: 1px;
            background: Theme.grid;
        }
        Rectangle {
            y: parent.height * root.band-top;
            height: 1px;
            background: Theme.target;
            opacity: 0.6;
        }
        Rectangle {
            y: parent.height * root.band-bottom;
            height: 1px;
            background: Theme.target;
            opacity: 0.6;
        }
        @children
    }
}

export component GlucoseGraph inherits Rectangle {
    in property <string> line-path;
    in property <[Dot]> dots;
    in property <[GraphPoint]> points;
    in property <[NoteMark]> notes;
    in property <[AxisLabel]> y-labels;
    in property <[AxisLabel]> x-labels;
    in property <float> band-top;
    in property <float> band-bottom;
    in property <string> empty-text: "No data yet";
    // 0 line, 1 dots, 2 line + dots
    in property <int> graph-style;
    // clicking a reading adds a note there, clicking a note marker edits it
    in property <bool> notes-enabled;
    callback add-note(string);
    callback edit-note(NoteMark);

    property <float> mouse-pos: touch.mouse-x / max(1px, frame.plot-width);
    property <int> hover-point: touch.has-hover && root.points.length > 0 ? ChartBridge.nearest-point(root.points, root.mouse-pos, 24px / max(1px, frame.plot-width)) : -1;
    property <int> hover-note: touch.has-hover && root.notes.length > 0 ? ChartBridge.nearest-note(root.notes, root.mouse-pos, 8px / max(1px, frame.plot-width)) : -1;
    property <GraphPoint> point: root.points[max(0, root.hover-point)];
    property <NoteMark> note: root.notes[max(0, root.hover-note)];

    frame := PlotFrame {
        width: 100%;
        height: 100%;
        y-labels: root.y-labels;
        x-labels: root.x-labels;
        band-top: root.band-top;
        band-bottom: root.band-bottom;

        // notes: a thin line with a marker at the top
        for n[i] in root.notes: Rectangle {
            x: frame.plot-width * n.x - 0.5px;
            width: 1px;
            background: Theme.primary;
            opacity: i == root.hover-note ? 0.9 : 0.45;
        }
        for n[i] in root.notes: Rectangle {
            property <length> size: i == root.hover-note ? 12px : 10px;
            x: frame.plot-width * n.x - self.size / 2;
            y: 2px;
            width: self.size;
            height: self.size;
            border-radius: self.size / 2;
            background: Theme.primary;
            border-width: 1.5px;
            border-color: Theme.surface;
        }

        if root.line-path != "" && root.graph-style != 1: Path {
            width: 100%;
            height: 100%;
            commands: root.line-path;
            viewbox-width: 1000;
            viewbox-height: 400;
            fit: fill;
            stroke: Theme.on-surface-variant;
            stroke-width: 2px;
            fill: transparent;
        }
        // the last dot is the current reading and drawn larger
        for d[i] in root.dots: Rectangle {
            property <bool> last: i == root.dots.length - 1;
            property <length> size: self.last ? 10px : 5px;
            x: frame.plot-width * d.x - self.size / 2;
            y: frame.plot-height * d.y - self.size / 2;
            width: self.size;
            height: self.size;
            border-radius: self.size / 2;
            background: Theme.level-color(d.level);
            border-width: self.last ? 2px : 0px;
            border-color: Theme.surface;
        }

        // hovered reading: guide line and a ring around the value
        if root.hover-point >= 0: Rectangle {
            x: frame.plot-width * root.point.x - 0.5px;
            width: 1px;
            background: Theme.on-surface-variant;
            opacity: 0.35;
        }
        if root.hover-point >= 0: Rectangle {
            x: frame.plot-width * root.point.x - 6px;
            y: frame.plot-height * root.point.y - 6px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: Theme.level-color(root.point.level);
            border-width: 2px;
            border-color: Theme.surface;
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: root.notes-enabled && (root.hover-note >= 0 || root.hover-point >= 0) ? pointer : default;
            clicked => {
                if root.hover-note >= 0 {
                    root.edit-note(root.note);
                } else if root.notes-enabled && root.hover-point >= 0 && root.point.when != "" {
                    root.add-note(root.point.when);
                }
            }
        }

        if root.hover-point >= 0 || root.hover-note >= 0: HoverTip {
            property <length> ax: frame.plot-width * (root.hover-point >= 0 ? root.point.x : root.note.x);
            property <length> ay: root.hover-point >= 0 ? frame.plot-height * root.point.y : 0px;
            time: root.hover-point >= 0 ? root.point.time : root.note.time;
            value: root.hover-point >= 0 ? root.point.value : "";
            level: root.point.level;
            note: root.hover-note >= 0 ? root.note.text : "";
            // beside the pointer, flipped at the right edge, kept inside the plot
            x: max(0px, self.ax + 14px + self.width > frame.plot-width ? self.ax - 14px - self.width : self.ax + 14px);
            y: max(0px, min(frame.plot-height - self.height, self.ay - self.height / 2));
        }
    }
    if root.line-path == "": Caption {
        text: root.empty-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AgpChart inherits Rectangle {
    in property <string> outer-path;
    in property <string> inner-path;
    in property <string> median-path;
    in property <[AxisLabel]> y-labels;
    in property <[AxisLabel]> x-labels;
    in property <float> band-top;
    in property <float> band-bottom;

    PlotFrame {
        width: 100%;
        height: 100%;
        y-labels: root.y-labels;
        x-labels: root.x-labels;
        band-top: root.band-top;
        band-bottom: root.band-bottom;

        if root.outer-path != "": Path {
            width: 100%;
            height: 100%;
            commands: root.outer-path;
            viewbox-width: 1000;
            viewbox-height: 400;
            fit: fill;
            fill: Theme.agp-outer;
            stroke-width: 0px;
        }
        if root.inner-path != "": Path {
            width: 100%;
            height: 100%;
            commands: root.inner-path;
            viewbox-width: 1000;
            viewbox-height: 400;
            fit: fill;
            fill: Theme.agp-inner;
            stroke-width: 0px;
        }
        if root.median-path != "": Path {
            width: 100%;
            height: 100%;
            commands: root.median-path;
            viewbox-width: 1000;
            viewbox-height: 400;
            fit: fill;
            stroke: Theme.agp-median;
            stroke-width: 2.5px;
            fill: transparent;
        }
    }
}

// Calendar cell: date, share in range and a small 24 h profile. Days with data are clickable;
// hovering shows the reading (and note) under the pointer in the header.
export component DayChart inherits Rectangle {
    in property <DayCard> day;
    in property <float> band-top;
    in property <float> band-bottom;
    callback clicked(int);
    property <bool> padding-cell: root.day.key < 0;
    property <float> mouse-pos: touch.mouse-x / max(1px, root.width);
    property <int> hover-point: touch.has-hover && root.day.has-data ? ChartBridge.nearest-point(root.day.points, root.mouse-pos, 6px / max(1px, root.width)) : -1;
    property <int> hover-note: touch.has-hover && root.day.notes.length > 0 ? ChartBridge.nearest-note(root.day.notes, root.mouse-pos, 5px / max(1px, root.width)) : -1;
    property <GraphPoint> point: root.day.points[max(0, root.hover-point)];
    border-radius: 8px;
    border-width: padding-cell ? 0px : 1px;
    border-color: touch.has-hover ? Theme.primary : Theme.outline-variant;
    background: padding-cell ? transparent : root.day.has-data ? Theme.surface : Theme.surface.with-alpha(0.4);
    clip: true;

    if !root.padding-cell: Text {
        x: 8px;
        y: 5px;
        text: root.hover-point >= 0 ? root.point.time : root.day.month != "" ? root.day.day + " " + root.day.month : root.day.day;
        font-size: 12px;
        font-weight: root.day.has-data ? 700 : 400;
        color: root.day.has-data ? Theme.on-surface : Theme.on-surface-variant.with-alpha(0.6);
    }
    if root.day.has-data: Text {
        x: parent.width - self.width - 8px;
        y: 5px;
        text: root.hover-point >= 0 ? root.point.value : root.day.in-range;
        font-size: 11px;
        font-weight: 600;
        color: Theme.level-color(root.hover-point >= 0 ? root.point.level : root.day.level);
    }
    if root.day.has-data: Rectangle {
        x: 0;
        y: 24px;
        width: parent.width;
        height: parent.height - 28px;
        Rectangle {
            y: parent.height * root.band-top;
            height: parent.height * (root.band-bottom - root.band-top);
            background: Theme.target-band;
        }
        Path {
            width: 100%;
            height: 100%;
            commands: root.day.path;
            viewbox-width: 1000;
            viewbox-height: 400;
            fit: fill;
            stroke: Theme.primary;
            stroke-width: 1.5px;
            fill: transparent;
        }
        for n in root.day.notes: Rectangle {
            x: parent.width * n.x - 1px;
            y: parent.height - self.height;
            width: 2px;
            height: 5px;
            background: Theme.primary;
        }
        if root.hover-point >= 0: Rectangle {
            x: parent.width * root.point.x - 0.5px;
            width: 1px;
            background: Theme.on-surface-variant;
            opacity: 0.4;
        }
        if root.hover-point >= 0: Rectangle {
            x: parent.width * root.point.x - 3px;
            y: parent.height * root.point.y - 3px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.level-color(root.point.level);
        }
    }
    if root.hover-note >= 0: Rectangle {
        y: parent.height - self.height;
        height: 18px;
        background: Theme.inverse-surface;
        Text {
            x: 6px;
            width: parent.width - 12px;
            text: root.day.notes[root.hover-note].text;
            color: Theme.inverse-on-surface;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.day.has-data;
        mouse-cursor: root.day.has-data ? pointer : default;
        clicked => { root.clicked(root.day.key); }
    }
}

export component TirChart inherits Rectangle {
    in property <[TirRow]> rows;
    HorizontalLayout {
        spacing: 16px;
        // stacked bar (very high on top)
        Rectangle {
            width: 36px;
            border-radius: 6px;
            clip: true;
            VerticalLayout {
                for r in root.rows: Rectangle {
                    vertical-stretch: max(r.pct, 0.0001);
                    min-height: r.pct > 0 ? 3px : 0px;
                    background: Theme.level-color(r.level);
                }
            }
        }
        VerticalLayout {
            alignment: space-between;
            for r in root.rows: HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: Theme.level-color(r.level);
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text {
                        text: r.label;
                        color: Theme.on-surface;
                        font-weight: 600;
                    }
                    Caption { text: r.range; }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: r.pct-text;
                        horizontal-alignment: right;
                        color: Theme.on-surface;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    Caption {
                        text: r.duration;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}

component Light inherits Rectangle {
    in property <int> light;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: Theme.light-color(light);
    if root.light == 1: Text {
        text: "OK";
        font-size: 10px;
        font-weight: 700;
        color: #ffffff;
    }
    if root.light == 0: Text {
        text: "–";
        font-size: 12px;
        color: Theme.on-surface-variant;
    }
}

export component InsightsTable inherits Rectangle {
    in property <[Insight]> rows;
    property <length> label-width: 170px;
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            height: 24px;
            Rectangle { width: root.label-width; }
            for r in root.rows: Text {
                horizontal-stretch: 1;
                text: r.label;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.on-surface-variant;
                font-size: 12px;
            }
        }
        for row-index in 3: Rectangle {
            height: 44px;
            border-radius: Theme.radius-s;
            background: Math.mod(row-index, 2) == 0 ? Theme.surface.with-alpha(Theme.dark ? 0.35 : 0.7) : transparent;
            HorizontalLayout {
                padding-left: 12px;
                Text {
                    width: root.label-width - 12px;
                    vertical-alignment: center;
                    text: row-index == 0 ? "Likelihood of low" : row-index == 1 ? "Median vs. goal" : "Variability below median";
                    color: Theme.on-surface;
                    font-size: 12px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                for r in root.rows: Rectangle {
                    horizontal-stretch: 1;
                    Light {
                        light: row-index == 0 ? r.low : row-index == 1 ? r.median : r.variability;
                    }
                }
            }
        }
    }
}
