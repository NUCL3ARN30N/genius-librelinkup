import { ComboBox, ScrollView, ListView, TextEdit, Palette, Spinner } from "std-widgets.slint";
import { Theme, Icons, Toast } from "theme.slint";
import { AppLogo, Card, Title, Caption, NavItem, IconButton, Icon, StatTile, StatItem, Chip, Banner, MButton, Segmented, MSwitch, TextField, Stepper, Swatch, Snackbar } from "components.slint";
import { GlucoseGraph, AgpChart, DayChart, TirChart, InsightsTable, TotalsChart, AxisLabel, Dot, TirRow, Insight, DayCard, DayBar, GraphPoint, NoteMark, ChartBridge } from "charts.slint";

export { AxisLabel, Dot, TirRow, Insight, DayCard, DayBar, StatItem, Theme, Toast, GraphPoint, NoteMark, ChartBridge }

export struct LogItem {
    time: string,
    title: string,
    status: string,
    ok: bool,
    detail: string,
}

export struct UiSettings {
    email: string,
    server-index: int,
    units: int,
    poll-seconds: int,
    target-low: string,
    target-high: string,
    notify-low: bool,
    low-threshold: string,
    notify-high: bool,
    high-threshold: string,
    notify-stale: bool,
    stale-minutes: int,
    repeat-minutes: int,
    notify-falling: bool,
    notify-rising: bool,
    // in the shown unit per minute
    fast-rate: string,
    notify-predicted: bool,
    predict-minutes: int,
    quiet-hours: bool,
    quiet-from: string,
    quiet-to: string,
    log-enabled: bool,
    log-dir: string,
    remember-passphrase: bool,
    dev-mode: bool,
    start-minimized: bool,
    autostart: bool,
    theme: int,
    // 0 system, 1 English, 2 German
    language: int,
    product: string,
    version: string,
}

export struct UiAppearance {
    accent: string,
    very-low: string,
    low: string,
    target: string,
    high: string,
    very-high: string,
    corners: int,
    graph-hours: int,
    graph-style: int,
    colored-card: bool,
    show-stats: bool,
    tray-shape: int,
    tray-arrow: bool,
    tray-arrow-separate: bool,
    tray-text: int,
    tray-font: int,
}

export global Dashboard {
    in property <[string]> patients;
    in-out property <int> patient-index;
    in property <string> value: "–";
    in property <string> unit;
    in property <string> trend;
    in property <int> trend-index;
    in property <string> trend-text;
    in property <int> level;
    in property <string> age;
    in property <bool> stale;
    in property <string> sensor;
    in property <string> graph-title: "Last 12 hours";
    in property <int> graph-style;
    in property <bool> colored-card: true;
    in property <bool> show-stats: true;
    in property <string> line-path;
    in property <[Dot]> dots;
    in property <[GraphPoint]> points;
    in property <[NoteMark]> notes;
    in property <[AxisLabel]> y-labels;
    in property <[AxisLabel]> x-labels;
    in property <float> band-top;
    in property <float> band-bottom;
    in property <[StatItem]> stats;
    callback select-patient(int);
}

export global Reports {
    in-out property <int> period-index: 1;
    in property <bool> available;
    in property <string> unavailable-text;
    in property <string> title;
    in property <string> subtitle;
    in property <[StatItem]> stats;
    in property <[TirRow]> tir;
    in property <string> outer-path;
    in property <string> inner-path;
    in property <string> median-path;
    in property <[AxisLabel]> y-labels;
    in property <[AxisLabel]> x-labels;
    in property <float> band-top;
    in property <float> band-bottom;
    in property <[Insight]> insights;
    in property <[DayCard]> days;
    in property <float> day-band-top;
    in property <float> day-band-bottom;
    // insulin & carbs from the notes; `ic-days` is empty when nothing was recorded
    in property <[StatItem]> ic-stats;
    in property <[DayBar]> ic-days;
    callback period-changed(int);

    // details of one day, opened from the calendar
    in-out property <bool> detail-open;
    in property <string> detail-title;
    in property <string> detail-line;
    in property <[Dot]> detail-dots;
    in property <[GraphPoint]> detail-points;
    in property <[NoteMark]> detail-notes;
    // the day as "2026-10-29", for new notes
    in property <string> detail-date;
    in property <[AxisLabel]> detail-y-labels;
    in property <[AxisLabel]> detail-x-labels;
    in property <float> detail-band-top;
    in property <float> detail-band-bottom;
    in property <[StatItem]> detail-stats;
    in property <[TirRow]> detail-tir;
    // "Rapid 12 u · Long 18 u · Carbs 160 g", empty without entries
    in property <string> detail-totals;
    // keys of the neighbouring days with data, -1 if there is none
    in property <int> detail-prev: -1;
    in property <int> detail-next: -1;
    callback open-day(int);
}

// What the note dialog sends to Rust; `units` and `carbs` are the text as typed ("4,5" or "4.5").
export struct NoteDraft {
    id: string,
    when: string,
    text: string,
    treatment: int,
    treatment-name: string,
    units: string,
    carbs: string,
}

// Notes at a point in time, kept in the glucose log folder. The dialog edits the in-out fields;
// Rust closes it once the note is saved.
export global Notes {
    in property <bool> available;
    in-out property <bool> open;
    // empty for a new note
    in-out property <string> id;
    // "2026-10-29 14:30"
    in-out property <string> when;
    in-out property <string> text;
    // 0 none, 1 rapid-acting insulin, 2 long-acting insulin, 3 custom (named) treatment
    in-out property <int> treatment;
    in-out property <string> treatment-name;
    in-out property <string> units;
    // grams
    in-out property <string> carbs;
    in-out property <string> error;
    in property <[string]> treatments: [@tr("None"), @tr("Rapid-acting insulin"), @tr("Long-acting insulin"), @tr("Custom…")];
    callback now() -> string;
    callback save(NoteDraft);
    callback delete(string);

    out property <bool> can-save: Notes.text != "" || Notes.treatment != 0 || Notes.carbs != "";
    public function draft() -> NoteDraft {
        return { id: Notes.id, when: Notes.when, text: Notes.text, treatment: Notes.treatment, treatment-name: Notes.treatment-name, units: Notes.units, carbs: Notes.carbs };
    }

    // empty `when`: now
    public function compose(when: string) {
        Notes.id = "";
        Notes.when = when != "" ? when : Notes.now();
        Notes.text = "";
        Notes.treatment = 0;
        Notes.treatment-name = "";
        Notes.units = "";
        Notes.carbs = "";
        Notes.error = "";
        Notes.open = true;
    }
    public function edit(n: NoteMark) {
        Notes.id = n.id;
        Notes.when = n.when;
        Notes.text = n.note;
        Notes.treatment = n.treatment;
        Notes.treatment-name = n.treatment-name;
        Notes.units = n.units;
        Notes.carbs = n.carbs;
        Notes.error = "";
        Notes.open = true;
    }
}

// The export dialog on the Reports page: a CSV file, a PDF report, or both in an encrypted ZIP
// attached to an email.
export global ExportBridge {
    // a glucose log is loaded
    in property <bool> available;
    in-out property <bool> open;
    // 0 the selected report period, 1 all data
    in-out property <int> range;
    // what goes into the email: 0 CSV, 1 PDF report, 2 both
    in-out property <int> format: 2;
    in-out property <string> recipient;
    in-out property <string> password;
    in-out property <string> repeat;
    in-out property <string> error;
    in property <bool> busy;
    // (range)
    callback save-csv(int);
    callback save-pdf(int);
    // (range, format, recipient, password, repeat)
    callback send(int, int, string, string, string);

    public function show() {
        ExportBridge.password = "";
        ExportBridge.repeat = "";
        ExportBridge.error = "";
        ExportBridge.open = true;
    }
}

// The About page: project links and what changed in this version.
export global About {
    in property <string> version;
    in property <string> changes;
    // 0 repository, 1 report a problem, 2 releases, 3 licence, 4 documentation
    callback open-link(int);
}

export global SettingsBridge {
    in property <UiSettings> settings;
    // in-out: the Appearance page writes its edits back here, otherwise reopening the page (it
    // is re-created on every visit) would show the values from before the edit
    in-out property <UiAppearance> appearance;
    in property <[string]> servers;
    in property <string> store-info;
    in property <bool> store-encrypted;
    in property <image> tray-preview;
    in property <image> tray-preview-actual;
    // the separate trend-arrow icon (empty when the arrow is part of the number icon)
    in property <image> tray-arrow-preview;
    in property <image> tray-arrow-preview-actual;
    in property <int> tray-actual-size: 16;
    callback save(UiSettings);
    callback appearance-changed(UiAppearance);
    callback reset-colors();
    callback browse-log-dir() -> string;
    // (current, new); the current passphrase is checked for an encrypted log
    callback set-passphrase(string, string);
    callback remove-passphrase(string);
    callback export-settings();
    callback import-settings();
    callback import-csv();
    callback open-data-folder();
    callback logout();
    in property <string> log-folder;
    in-out property <bool> wipe-open;
    // true: also delete the glucose log files
    callback wipe-data(bool);
}

export global UpdateBridge {
    in property <string> current-version;
    in property <string> install-kind;
    in property <string> status;
    in property <bool> available;
    in property <string> latest-version;
    in property <string> notes;
    in property <bool> busy;
    // 0..1 while downloading, below 0 when idle
    in property <float> progress: -1;
    in property <bool> can-install;
    in-out property <bool> auto-check: true;
    callback check();
    callback install();
    callback skip();
    callback open-page();
    callback options-changed(bool);
}

export global SyncBridge {
    in property <bool> paired;
    in property <string> server;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> busy;
    in-out property <bool> use-as-source: true;
    callback pair(string, bool);
    callback unpair();
    callback sync-now();
    callback source-changed(bool);
}

export global DevBridge {
    in property <[LogItem]> entries;
    in property <string> log-path;
    callback clear();
    callback open-log-folder();
}

component SettingsSection inherits Card {
    in property <string> title;
    in property <string> subtitle;
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        VerticalLayout {
            spacing: 2px;
            Title { text: root.title; }
            if root.subtitle != "": Caption { text: root.subtitle; }
        }
        @children
    }
}

component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.title;
            font-size: 28px;
            color: Theme.on-surface;
        }
        if root.subtitle != "": Caption { text: root.subtitle; }
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

component DashboardPage inherits Rectangle {
    callback refresh();
    in property <string> status;
    in property <bool> status-error;
    in property <bool> busy;

    property <color> range-color: Theme.level-color(Dashboard.level);
    property <bool> filled: Dashboard.colored-card;
    property <color> card-ink: root.filled ? (Dashboard.level == 4 ? #1b1b1b : #ffffff) : Theme.on-surface;
    property <color> card-ink-soft: root.filled ? root.card-ink.with-alpha(0.8) : Theme.on-surface-variant;

    VerticalLayout {
        padding: 24px;
        spacing: Theme.gap;

        PageHeader {
            title: @tr("My glucose");
            if Dashboard.patients.length > 1: ComboBox {
                y: (parent.height - self.height) / 2;
                width: 220px;
                model: Dashboard.patients;
                current-index <=> Dashboard.patient-index;
                selected => { Dashboard.select-patient(self.current-index); }
            }
            Chip {
                y: (parent.height - self.height) / 2;
                text: root.status;
                error: root.status-error;
            }
            if root.busy: Spinner {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.refresh;
                clicked => { root.refresh(); }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            height: 196px;

            Card {
                width: Dashboard.show-stats ? 300px : self.preferred-width;
                horizontal-stretch: Dashboard.show-stats ? 0 : 1;
                tone: root.filled ? root.range-color : Theme.surface-container;
                border-width: root.filled ? 0px : 2px;
                border-color: root.range-color;
                animate tone { duration: 300ms; }
                VerticalLayout {
                    padding: 20px;
                    spacing: 2px;
                    HorizontalLayout {
                        Text {
                            text: Dashboard.level == 1 ? @tr("VERY LOW") : Dashboard.level == 2 ? @tr("LOW") : Dashboard.level == 3 ? @tr("IN RANGE") : Dashboard.level == 4 ? @tr("HIGH") : Dashboard.level == 5 ? @tr("VERY HIGH") : @tr("NO DATA");
                            color: root.filled ? root.card-ink-soft : root.range-color;
                            font-size: 13px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: Dashboard.age;
                            horizontal-alignment: right;
                            color: root.card-ink-soft;
                            font-size: 13px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: Dashboard.value;
                            font-size: 76px;
                            font-weight: 700;
                            color: root.filled ? root.card-ink : root.range-color;
                            opacity: Dashboard.stale ? 0.5 : 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            if Dashboard.trend-index > 0: Icon {
                                width: 48px;
                                height: 48px;
                                path: Icons.trend(Dashboard.trend-index);
                                tint: root.filled ? root.card-ink : root.range-color;
                            }
                            Text {
                                text: Dashboard.unit;
                                color: root.card-ink-soft;
                                font-size: 14px;
                            }
                        }
                    }
                    Text {
                        text: Dashboard.trend-text;
                        color: root.card-ink-soft;
                        font-size: 13px;
                    }
                }
            }

            if Dashboard.show-stats: Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Title { text: @tr("Last 24 hours"); }
                    HorizontalLayout {
                        spacing: 24px;
                        for s in Dashboard.stats: StatTile { item: s; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            path: Icons.sensor;
                            width: 18px;
                            height: 18px;
                        }
                        Caption {
                            text: Dashboard.sensor;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Card {
            vertical-stretch: 1;
            min-height: 260px;
            VerticalLayout {
                padding: 20px;
                padding-top: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    min-height: 40px;
                    Title {
                        text: Dashboard.graph-title;
                        vertical-alignment: center;
                    }
                    Caption {
                        horizontal-stretch: 1;
                        text: Notes.available ? @tr("Point at the graph for values · click it to add a note there") : @tr("Point at the graph for values");
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    if Notes.available: MButton {
                        y: (parent.height - self.height) / 2;
                        text: @tr("Add note");
                        kind: 3;
                        icon: Icons.note;
                        clicked => { Notes.compose(""); }
                    }
                }
                GlucoseGraph {
                    vertical-stretch: 1;
                    graph-style: Dashboard.graph-style;
                    line-path: Dashboard.line-path;
                    dots: Dashboard.dots;
                    points: Dashboard.points;
                    notes: Dashboard.notes;
                    y-labels: Dashboard.y-labels;
                    x-labels: Dashboard.x-labels;
                    band-top: Dashboard.band-top;
                    band-bottom: Dashboard.band-bottom;
                    notes-enabled: Notes.available;
                    add-note(when) => { Notes.compose(when); }
                    edit-note(n) => { Notes.edit(n); }
                }
            }
        }
    }
}

component ReportsPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: Theme.gap;

            PageHeader {
                title: @tr("Glucose report");
                subtitle: Reports.subtitle;
                if ExportBridge.available: MButton {
                    y: (parent.height - self.height) / 2;
                    text: @tr("Export…");
                    kind: 2;
                    icon: Icons.download;
                    clicked => { ExportBridge.show(); }
                }
                Segmented {
                    y: (parent.height - self.height) / 2;
                    width: 300px;
                    options: [@tr("7 d"), @tr("14 d"), @tr("30 d"), @tr("90 d")];
                    selected <=> Reports.period-index;
                    changed(i) => { Reports.period-changed(i); }
                }
            }

            if !Reports.available: Card {
                height: 120px;
                VerticalLayout {
                    padding: 24px;
                    alignment: center;
                    Caption {
                        text: Reports.unavailable-text;
                        horizontal-alignment: center;
                        font-size: 14px;
                    }
                }
            }

            if Reports.available: HorizontalLayout {
                spacing: Theme.gap;
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        Title { text: @tr("Glucose statistics"); }
                        for s in Reports.stats: HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: s.label;
                                    color: Theme.on-surface;
                                }
                                if s.hint != "": Caption { text: s.hint; }
                            }
                            Text {
                                text: s.value;
                                color: Theme.on-surface;
                                font-size: 18px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        Title { text: @tr("Time in ranges"); }
                        TirChart {
                            min-height: 260px;
                            vertical-stretch: 1;
                            rows: Reports.tir;
                        }
                        Caption { text: @tr("Goals (most adults with type 1/2): target > 70 %, low < 4 %, very low < 1 %, high < 25 %, very high < 5 %."); }
                    }
                }
            }

            if Reports.available: Card {
                height: 380px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    Title { text: @tr("Ambulatory glucose profile (AGP)"); }
                    Caption { text: @tr("Median (line) with 25–75 % (dark) and 5–95 % (light) percentiles, as if all days happened in a single day."); }
                    AgpChart {
                        vertical-stretch: 1;
                        outer-path: Reports.outer-path;
                        inner-path: Reports.inner-path;
                        median-path: Reports.median-path;
                        y-labels: Reports.y-labels;
                        x-labels: Reports.x-labels;
                        band-top: Reports.band-top;
                        band-bottom: Reports.band-bottom;
                    }
                }
            }

            if Reports.available: Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Title { text: @tr("Glucose pattern insights"); }
                    InsightsTable { rows: Reports.insights; }
                    Caption { text: @tr("Traffic lights are a simplified, informational approximation of LibreView's pattern insights – not medical advice."); }
                }
            }

            if Reports.available: Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Title { text: @tr("Insulin & carbs"); }
                    if Reports.ic-days.length == 0: Caption {
                        text: @tr("No insulin or carbs were recorded in this period. Add them to a note (Add note on the Glucose page, or click the graph) and they are summed up here.");
                        font-size: 13px;
                    }
                    if Reports.ic-days.length > 0: HorizontalLayout {
                        spacing: 32px;
                        VerticalLayout {
                            width: 300px;
                            spacing: 10px;
                            for s in Reports.ic-stats: HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        text: s.label;
                                        color: Theme.on-surface;
                                    }
                                    if s.hint != "": Caption { text: s.hint; }
                                }
                                Text {
                                    text: s.value;
                                    color: Theme.on-surface;
                                    font-size: 16px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            TotalsChart {
                                min-height: 170px;
                                vertical-stretch: 1;
                                days: Reports.ic-days;
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                for item in [{ c: Theme.insulin, t: @tr("Insulin (units)") }, { c: Theme.carbs, t: @tr("Carbs (grams)") }]: HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 2px;
                                        background: item.c;
                                    }
                                    Caption {
                                        text: item.t;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    if Reports.ic-days.length > 0: Caption { text: @tr("Averages count only the days with entries. The totals come from your notes and are only as complete as they are."); }
                }
            }

            if Reports.available && Reports.days.length > 0: Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    Title { text: @tr("Daily glucose profiles"); }
                    Caption { text: @tr("Share of the day in the target range and the course of each day. Point at a day to read values, click it for details and notes."); }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        for name in [@tr("Mon"), @tr("Tue"), @tr("Wed"), @tr("Thu"), @tr("Fri"), @tr("Sat"), @tr("Sun")]: Text {
                            horizontal-stretch: 1;
                            text: name;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            color: Theme.on-surface-variant;
                        }
                    }
                    for row in ceil(Reports.days.length / 7): HorizontalLayout {
                        spacing: 8px;
                        height: 84px;
                        for col in 7: Rectangle {
                            horizontal-stretch: 1;
                            property <int> index: row * 7 + col;
                            if index < Reports.days.length: DayChart {
                                width: 100%;
                                height: 100%;
                                day: Reports.days[index];
                                band-top: Reports.day-band-top;
                                band-bottom: Reports.day-band-bottom;
                                clicked(key) => { Reports.open-day(key); }
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    property <UiSettings> s: SettingsBridge.settings;
    property <string> current-passphrase;
    changed s => { self.load(); }
    init => { self.load(); }

    function load() {
        server.current-index = s.server-index;
        units.selected = s.units;
        theme.selected = s.theme;
        language.selected = s.language;
        poll.value = s.poll-seconds;
        target-low.text = s.target-low;
        target-high.text = s.target-high;
        notify-low.checked = s.notify-low;
        low-th.text = s.low-threshold;
        notify-high.checked = s.notify-high;
        high-th.text = s.high-threshold;
        notify-stale.checked = s.notify-stale;
        stale-min.value = s.stale-minutes;
        repeat-min.value = s.repeat-minutes;
        notify-falling.checked = s.notify-falling;
        notify-rising.checked = s.notify-rising;
        fast-rate.text = s.fast-rate;
        notify-predicted.checked = s.notify-predicted;
        predict-min.value = s.predict-minutes;
        quiet.checked = s.quiet-hours;
        quiet-from.text = s.quiet-from;
        quiet-to.text = s.quiet-to;
        log-enabled.checked = s.log-enabled;
        log-dir.text = s.log-dir;
        remember-pass.checked = s.remember-passphrase;
        dev-mode.checked = s.dev-mode;
        start-min.checked = s.start-minimized;
        autostart.checked = s.autostart;
        product.text = s.product;
        version.text = s.version;
    }

    function collect() -> UiSettings {
        return {
            email: s.email,
            server-index: server.current-index,
            units: units.selected,
            poll-seconds: poll.value,
            target-low: target-low.text,
            target-high: target-high.text,
            notify-low: notify-low.checked,
            low-threshold: low-th.text,
            notify-high: notify-high.checked,
            high-threshold: high-th.text,
            notify-stale: notify-stale.checked,
            stale-minutes: stale-min.value,
            repeat-minutes: repeat-min.value,
            notify-falling: notify-falling.checked,
            notify-rising: notify-rising.checked,
            fast-rate: fast-rate.text,
            notify-predicted: notify-predicted.checked,
            predict-minutes: predict-min.value,
            quiet-hours: quiet.checked,
            quiet-from: quiet-from.text,
            quiet-to: quiet-to.text,
            log-enabled: log-enabled.checked,
            log-dir: log-dir.text,
            remember-passphrase: remember-pass.checked,
            dev-mode: dev-mode.checked,
            start-minimized: start-min.checked,
            autostart: autostart.checked,
            theme: theme.selected,
            language: language.selected,
            product: product.text,
            version: version.text,
        };
    }

    VerticalLayout {
        PageHeader {
            padding: 24px;
            padding-bottom: 8px;
            title: @tr("Settings");
            MButton {
                y: (parent.height - self.height) / 2;
                text: @tr("Revert");
                kind: 3;
                clicked => { root.load(); }
            }
            MButton {
                y: (parent.height - self.height) / 2;
                text: @tr("Save");
                kind: 0;
                icon: Icons.check;
                clicked => { SettingsBridge.save(root.collect()); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 24px;
                padding-top: 8px;
                spacing: Theme.gap;

                SettingsSection {
                    title: @tr("Account");
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: s.email != "" ? @tr("Signed in as {}", s.email) : @tr("Not signed in to LibreLinkUp – values come from the caching server");
                            color: Theme.on-surface;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if s.email != "": MButton {
                            text: @tr("Sign out");
                            kind: 2;
                            clicked => { SettingsBridge.logout(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Caption { text: @tr("LibreLinkUp server – automatic follows Abbott's regional redirects"); }
                        server := ComboBox { model: SettingsBridge.servers; }
                    }
                }

                SettingsSection {
                    title: @tr("Caching server");
                    subtitle: @tr("An always-on gllu-server keeps polling while this computer is off and fills the gaps here.");
                    if !SyncBridge.paired: VerticalLayout {
                        spacing: 12px;
                        Caption {
                            text: @tr("On the server run  gllu-server pair  (Docker: docker exec gllu gllu-server pair) and paste the code. The code pins the server's certificate, so the connection cannot be intercepted.");
                            font-size: 13px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            pair-code := TextField {
                                horizontal-stretch: 1;
                                placeholder: "gllu1:…";
                            }
                            VerticalLayout {
                                alignment: center;
                                MButton {
                                    text: @tr("Pair");
                                    kind: 0;
                                    enabled: pair-code.text != "" && !SyncBridge.busy;
                                    clicked => {
                                        SyncBridge.pair(pair-code.text, source.checked);
                                        pair-code.text = "";
                                    }
                                }
                            }
                        }
                    }
                    if SyncBridge.paired: HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: SyncBridge.server;
                                color: Theme.on-surface;
                                wrap: word-wrap;
                            }
                        }
                        MButton {
                            text: @tr("Sync now");
                            kind: 1;
                            icon: Icons.refresh;
                            enabled: !SyncBridge.busy;
                            clicked => { SyncBridge.sync-now(); }
                        }
                        MButton {
                            text: @tr("Unpair");
                            kind: 3;
                            clicked => { SyncBridge.unpair(); }
                        }
                    }
                    if SyncBridge.status != "": Text {
                        text: SyncBridge.status;
                        color: SyncBridge.status-error ? Theme.error : Theme.on-surface-variant;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    source := MSwitch {
                        text: @tr("Use the server for live values");
                        supporting: @tr("This computer then stops polling LibreLinkUp itself – fewer logins on your account.");
                        checked <=> SyncBridge.use-as-source;
                        toggled(v) => { SyncBridge.source-changed(v); }
                    }
                }

                SettingsSection {
                    title: @tr("Display");
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Caption { text: @tr("Units"); }
                            units := Segmented { options: [@tr("Automatic"), "mmol/L", "mg/dL"]; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Caption { text: @tr("Theme"); }
                            theme := Segmented { options: [@tr("System"), @tr("Light"), @tr("Dark")]; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Caption { text: @tr("Language"); }
                            language := Segmented { options: [@tr("System"), "English", "Deutsch"]; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        target-low := TextField {
                            label: @tr("Target range low");
                            input-type: decimal;
                        }
                        target-high := TextField {
                            label: @tr("Target range high");
                            input-type: decimal;
                        }
                        poll := Stepper {
                            label: @tr("Refresh every");
                            suffix: @tr("s");
                            minimum: 30;
                            maximum: 900;
                            step: 30;
                        }
                    }
                    Caption { text: @tr("Values are entered in the unit currently shown (mmol/L or mg/dL)."); }
                }

                SettingsSection {
                    title: @tr("Notifications");
                    HorizontalLayout {
                        spacing: 16px;
                        notify-low := MSwitch {
                            horizontal-stretch: 1;
                            text: @tr("Low glucose");
                            supporting: @tr("Notify when the value is at or below the threshold");
                        }
                        low-th := TextField {
                            width: 140px;
                            input-type: decimal;
                            enabled: notify-low.checked;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        notify-high := MSwitch {
                            horizontal-stretch: 1;
                            text: @tr("High glucose");
                            supporting: @tr("Notify when the value is at or above the threshold");
                        }
                        high-th := TextField {
                            width: 140px;
                            input-type: decimal;
                            enabled: notify-high.checked;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        notify-stale := MSwitch {
                            horizontal-stretch: 1;
                            text: @tr("No new data");
                            supporting: @tr("Notify when no reading arrived for a while");
                        }
                        stale-min := Stepper {
                            width: 140px;
                            suffix: @tr("min");
                            minimum: 5;
                            maximum: 240;
                            step: 5;
                            enabled: notify-stale.checked;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        notify-predicted := MSwitch {
                            horizontal-stretch: 1;
                            text: @tr("Predicted low");
                            supporting: @tr("Notify when the trend of the last 20 minutes reaches the low threshold soon");
                        }
                        predict-min := Stepper {
                            width: 140px;
                            suffix: @tr("min");
                            minimum: 10;
                            maximum: 30;
                            step: 5;
                            enabled: notify-predicted.checked;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            notify-falling := MSwitch {
                                text: @tr("Falling fast");
                                supporting: @tr("Trend arrow straight down, or faster than the rate on the right");
                            }
                            notify-rising := MSwitch {
                                text: @tr("Rising fast");
                                supporting: @tr("Trend arrow straight up, or faster than the rate on the right");
                            }
                        }
                        fast-rate := TextField {
                            width: 140px;
                            label: @tr("Rate per minute");
                            enabled: notify-falling.checked || notify-rising.checked;
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        quiet := MSwitch {
                            horizontal-stretch: 1;
                            text: @tr("Quiet hours");
                            supporting: @tr("Only urgent lows (below 3.0 mmol/L · 54 mg/dL) notify; anything else in this time is not shown later either");
                        }
                        quiet-from := TextField {
                            width: 90px;
                            label: @tr("From");
                            placeholder: "22:00";
                            enabled: quiet.checked;
                        }
                        quiet-to := TextField {
                            width: 90px;
                            label: @tr("To");
                            placeholder: "07:00";
                            enabled: quiet.checked;
                        }
                    }
                    Caption { text: @tr("Snooze alerts from the tray icon's menu (30 minutes to 2 hours). Urgent lows are never snoozed."); }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: @tr("Repeat active alerts");
                                color: Theme.on-surface;
                            }
                            Caption { text: @tr("Low, high and no data; 0 = notify only once per episode"); }
                        }
                        repeat-min := Stepper {
                            width: 140px;
                            suffix: @tr("min");
                            minimum: 0;
                            maximum: 240;
                            step: 5;
                        }
                    }
                }

                SettingsSection {
                    title: @tr("Glucose log & reports");
                    log-enabled := MSwitch {
                        text: @tr("Keep a local log of all readings");
                        supporting: @tr("Needed for reports and HbA1c – LibreLinkUp only keeps 12 hours");
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        log-dir := TextField {
                            horizontal-stretch: 1;
                            label: @tr("Log folder – choose a synced folder (Nextcloud, OneDrive, …) to share it between machines");
                            placeholder: @tr("Default data folder");
                        }
                        VerticalLayout {
                            alignment: end;
                            HorizontalLayout {
                                spacing: 8px;
                                MButton {
                                    text: @tr("Browse…");
                                    kind: 1;
                                    clicked => {
                                        let p = SettingsBridge.browse-log-dir();
                                        if p != "" { log-dir.text = p; }
                                    }
                                }
                                MButton {
                                    text: @tr("Open");
                                    kind: 3;
                                    icon: Icons.folder;
                                    clicked => { SettingsBridge.open-data-folder(); }
                                }
                            }
                        }
                    }
                    Caption {
                        text: SettingsBridge.store-info;
                        font-size: 13px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if SettingsBridge.store-encrypted: TextField {
                            horizontal-stretch: 1;
                            input-type: password;
                            placeholder: @tr("Current passphrase");
                            text <=> root.current-passphrase;
                        }
                        new-pass := TextField {
                            horizontal-stretch: 1;
                            input-type: password;
                            placeholder: SettingsBridge.store-encrypted ? @tr("New passphrase") : @tr("Passphrase to encrypt the log");
                        }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                MButton {
                                    text: SettingsBridge.store-encrypted ? @tr("Change passphrase") : @tr("Encrypt log");
                                    kind: 1;
                                    icon: Icons.lock;
                                    enabled: new-pass.text != "" && (!SettingsBridge.store-encrypted || root.current-passphrase != "");
                                    clicked => {
                                        SettingsBridge.set-passphrase(root.current-passphrase, new-pass.text);
                                        new-pass.text = "";
                                        root.current-passphrase = "";
                                    }
                                }
                                if SettingsBridge.store-encrypted: MButton {
                                    text: @tr("Remove encryption");
                                    kind: 3;
                                    enabled: root.current-passphrase != "";
                                    clicked => {
                                        SettingsBridge.remove-passphrase(root.current-passphrase);
                                        root.current-passphrase = "";
                                    }
                                }
                            }
                        }
                    }
                    if SettingsBridge.store-encrypted: Caption {
                        text: @tr("Changing or removing the passphrase needs the current one.");
                    }
                    remember-pass := MSwitch { text: @tr("Remember the log passphrase in the system keychain"); }
                }

                SettingsSection {
                    title: @tr("Import & export");
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        MButton {
                            text: @tr("Export settings…");
                            kind: 2;
                            clicked => { SettingsBridge.export-settings(); }
                        }
                        MButton {
                            text: @tr("Import settings…");
                            kind: 2;
                            clicked => { SettingsBridge.import-settings(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        MButton {
                            text: @tr("Import readings (CSV / LibreView)…");
                            kind: 2;
                            clicked => { SettingsBridge.import-csv(); }
                        }
                    }
                    Caption { text: @tr("Tip: import a LibreView \"Download glucose data\" CSV to backfill history older than 12 hours. Readings and notes are exported on the Reports page (Export…)."); }
                }

                SettingsSection {
                    title: @tr("Updates");
                    subtitle: @tr("Version {} · {}", UpdateBridge.current-version, UpdateBridge.install-kind);
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: UpdateBridge.available ? @tr("Version {} is available", UpdateBridge.latest-version) : UpdateBridge.status;
                                color: UpdateBridge.available ? Theme.primary : Theme.on-surface;
                                font-weight: UpdateBridge.available ? 700 : 400;
                                wrap: word-wrap;
                            }
                            if UpdateBridge.available && UpdateBridge.status != "": Caption { text: UpdateBridge.status; }
                        }
                        if UpdateBridge.busy && UpdateBridge.progress < 0: Spinner {
                            width: 24px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            indeterminate: true;
                        }
                        MButton {
                            text: @tr("Check now");
                            kind: UpdateBridge.available ? 3 : 1;
                            enabled: !UpdateBridge.busy;
                            clicked => { UpdateBridge.check(); }
                        }
                        if UpdateBridge.available && UpdateBridge.can-install: MButton {
                            text: @tr("Update now");
                            kind: 0;
                            enabled: !UpdateBridge.busy;
                            clicked => { UpdateBridge.install(); }
                        }
                        if UpdateBridge.available: MButton {
                            text: UpdateBridge.can-install ? @tr("Release page") : @tr("Download");
                            kind: UpdateBridge.can-install ? 3 : 0;
                            clicked => { UpdateBridge.open-page(); }
                        }
                    }
                    if UpdateBridge.progress >= 0: Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.surface-container-high;
                        Rectangle {
                            x: 0;
                            width: parent.width * UpdateBridge.progress;
                            border-radius: 3px;
                            background: Theme.primary;
                        }
                    }
                    if UpdateBridge.available && UpdateBridge.notes != "": Caption {
                        text: UpdateBridge.notes;
                        font-size: 13px;
                    }
                    if UpdateBridge.available: HorizontalLayout {
                        alignment: start;
                        MButton {
                            text: @tr("Skip this version");
                            kind: 3;
                            clicked => { UpdateBridge.skip(); }
                        }
                    }
                    MSwitch {
                        text: @tr("Check for updates automatically");
                        checked <=> UpdateBridge.auto-check;
                        toggled => { UpdateBridge.options-changed(UpdateBridge.auto-check); }
                    }
                }

                SettingsSection {
                    title: @tr("System");
                    start-min := MSwitch { text: @tr("Start minimized to tray"); }
                    autostart := MSwitch { text: @tr("Start when I sign in"); }
                    dev-mode := MSwitch {
                        text: @tr("Developer mode");
                        supporting: @tr("Shows the API log (secrets and personal data redacted)");
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        product := TextField { label: @tr("Advanced: client product header"); }
                        version := TextField { label: @tr("Advanced: client version (raised automatically when required)"); }
                    }
                }

                SettingsSection {
                    title: @tr("Delete local data");
                    subtitle: @tr("Removes everything this app stored on this computer: settings, logs, the keychain entries and, if you choose, the glucose log. The app closes afterwards.");
                    HorizontalLayout {
                        alignment: start;
                        MButton {
                            text: @tr("Delete all local data…");
                            kind: 4;
                            icon: Icons.delete;
                            clicked => { SettingsBridge.wipe-open = true; }
                        }
                    }
                }

                Caption {
                    text: @tr("Genius LibreLinkUp is an unofficial tool and not affiliated with Abbott. It uses an undocumented API that may change at any time. Do not make treatment decisions based on this app.");
                }
            }
        }
    }
}

component ColorRow inherits HorizontalLayout {
    in property <string> label;
    in property <color> swatch;
    in-out property <string> hex <=> field.text;
    callback edited();
    spacing: 12px;
    Swatch {
        y: (parent.height - self.height) / 2;
        fill: root.swatch;
    }
    Text {
        width: 110px;
        text: root.label;
        vertical-alignment: center;
        color: Theme.on-surface;
    }
    field := TextField {
        width: 130px;
        edited => { root.edited(); }
    }
}

component AppearancePage inherits Rectangle {
    property <UiAppearance> a: SettingsBridge.appearance;
    changed a => { self.load(); }
    init => { self.load(); }

    property <[string]> presets: ["#1d5fa8", "#00639b", "#006a6a", "#2e7d32", "#6750a4", "#8b4a62", "#b3261e", "#9a5b00", "#5d5f66"];
    property <[color]> preset-colors: [#1d5fa8, #00639b, #006a6a, #2e7d32, #6750a4, #8b4a62, #b3261e, #9a5b00, #5d5f66];

    function load() {
        accent.text = a.accent;
        vlow.hex = a.very-low;
        low.hex = a.low;
        target.hex = a.target;
        high.hex = a.high;
        vhigh.hex = a.very-high;
        corners.selected = a.corners;
        hours.selected = a.graph-hours;
        gstyle.selected = a.graph-style;
        colored.checked = a.colored-card;
        stats.checked = a.show-stats;
        shape.selected = a.tray-shape;
        arrow.checked = a.tray-arrow;
        arrow-separate.checked = a.tray-arrow-separate;
        ink.selected = a.tray-text;
        font.selected = a.tray-font;
    }

    function emit() {
        SettingsBridge.appearance = {
            accent: accent.text,
            very-low: vlow.hex,
            low: low.hex,
            target: target.hex,
            high: high.hex,
            very-high: vhigh.hex,
            corners: corners.selected,
            graph-hours: hours.selected,
            graph-style: gstyle.selected,
            colored-card: colored.checked,
            show-stats: stats.checked,
            tray-shape: shape.selected,
            tray-arrow: arrow.checked,
            tray-arrow-separate: arrow-separate.checked,
            tray-text: ink.selected,
            tray-font: font.selected,
        };
        SettingsBridge.appearance-changed(SettingsBridge.appearance);
    }

    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: Theme.gap;

            PageHeader {
                title: @tr("Appearance");
                subtitle: @tr("Changes apply immediately and are saved automatically.");
            }

            SettingsSection {
                title: @tr("Tray icon");
                HorizontalLayout {
                    spacing: 24px;
                    Rectangle {
                        width: arrow.checked && arrow-separate.checked ? 176px : 132px;
                        height: 132px;
                        border-radius: Theme.radius-m;
                        background: Theme.dark ? #202020 : #f3f3f3;
                        border-width: 1px;
                        border-color: Theme.outline-variant;
                        preview := VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            property <bool> two: arrow.checked && arrow-separate.checked;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                Image {
                                    width: preview.two ? 52px : 64px;
                                    height: self.width;
                                    source: SettingsBridge.tray-preview;
                                    image-rendering: pixelated;
                                }
                                if preview.two: Image {
                                    width: 52px;
                                    height: self.width;
                                    source: SettingsBridge.tray-arrow-preview;
                                    image-rendering: pixelated;
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Image {
                                    width: SettingsBridge.tray-actual-size * 1px;
                                    height: SettingsBridge.tray-actual-size * 1px;
                                    source: SettingsBridge.tray-preview-actual;
                                    image-rendering: pixelated;
                                }
                                if preview.two: Image {
                                    width: SettingsBridge.tray-actual-size * 1px;
                                    height: SettingsBridge.tray-actual-size * 1px;
                                    source: SettingsBridge.tray-arrow-preview-actual;
                                    image-rendering: pixelated;
                                }
                                Caption {
                                    text: SettingsBridge.tray-actual-size + @tr(" px");
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Caption { text: @tr("Shape"); }
                            shape := Segmented {
                                options: [@tr("Number only"), @tr("Drop"), @tr("Circle"), @tr("Square")];
                                changed => { root.emit(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Caption { text: @tr("Text colour"); }
                                ink := Segmented {
                                    options: [@tr("Auto"), @tr("White"), @tr("Black")];
                                    changed => { root.emit(); }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Caption { text: @tr("Font"); }
                                font := Segmented {
                                    options: [@tr("Condensed"), @tr("Regular"), @tr("Mono")];
                                    changed => { root.emit(); }
                                }
                            }
                        }
                        arrow := MSwitch {
                            text: @tr("Show the trend arrow");
                            supporting: arrow-separate.checked ? @tr("As a second tray icon next to the number") : @tr("Inside the number icon – the number gets a little narrower to make room");
                            toggled => { root.emit(); }
                        }
                        arrow-separate := MSwitch {
                            enabled: arrow.checked;
                            text: @tr("Show the arrow as a separate tray icon");
                            supporting: @tr("Keeps the number large and readable. Windows may first put the new icon among the hidden icons – drag it next to the value to keep it visible.");
                            toggled => { root.emit(); }
                        }
                    }
                }
            }

            SettingsSection {
                title: @tr("Colours");
                VerticalLayout {
                    spacing: 6px;
                    Caption { text: @tr("Accent colour"); }
                    HorizontalLayout {
                        spacing: 10px;
                        for p[i] in root.preset-colors: Swatch {
                            y: (parent.height - self.height) / 2;
                            fill: p;
                            selected: accent.text == root.presets[i];
                            clicked => {
                                accent.text = root.presets[i];
                                root.emit();
                            }
                        }
                        accent := TextField {
                            width: 130px;
                            placeholder: "#rrggbb";
                            edited => { root.emit(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                HorizontalLayout {
                    spacing: 32px;
                    VerticalLayout {
                        spacing: 8px;
                        Caption { text: @tr("Glucose range colours (graphs, value card and tray)"); }
                        vhigh := ColorRow {
                            label: @tr("Very high");
                            swatch: Theme.very-high;
                            edited => { root.emit(); }
                        }
                        high := ColorRow {
                            label: @tr("High");
                            swatch: Theme.high;
                            edited => { root.emit(); }
                        }
                        target := ColorRow {
                            label: @tr("In range");
                            swatch: Theme.target;
                            edited => { root.emit(); }
                        }
                        low := ColorRow {
                            label: @tr("Low");
                            swatch: Theme.low;
                            edited => { root.emit(); }
                        }
                        vlow := ColorRow {
                            label: @tr("Very low");
                            swatch: Theme.very-low;
                            edited => { root.emit(); }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        MButton {
                            text: @tr("Reset range colours");
                            kind: 3;
                            clicked => { SettingsBridge.reset-colors(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            SettingsSection {
                title: @tr("Layout");
                VerticalLayout {
                    spacing: 4px;
                    Caption { text: @tr("Corners"); }
                    corners := Segmented {
                        width: 360px;
                        options: [@tr("Square"), @tr("Rounded"), @tr("Round")];
                        changed => { root.emit(); }
                    }
                }
                colored := MSwitch {
                    text: @tr("Fill the current value card with the range colour");
                    toggled => { root.emit(); }
                }
                stats := MSwitch {
                    text: @tr("Show the 24-hour statistics card");
                    toggled => { root.emit(); }
                }
            }

            SettingsSection {
                title: @tr("Glucose graph");
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Caption { text: @tr("Time span"); }
                        hours := Segmented {
                            options: [@tr("3 h"), @tr("6 h"), @tr("12 h"), @tr("24 h")];
                            changed => { root.emit(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Caption { text: @tr("Style"); }
                        gstyle := Segmented {
                            options: [@tr("Line"), @tr("Dots"), @tr("Line + dots")];
                            changed => { root.emit(); }
                        }
                    }
                }
            }
        }
    }
}

component LinkRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    callback clicked;
    height: 56px;
    border-radius: Theme.radius-m;
    background: touch.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        Icon {
            y: (parent.height - self.height) / 2;
            path: root.icon;
            tint: Theme.primary;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.title;
                color: Theme.on-surface;
            }
            Caption {
                text: root.subtitle;
                wrap: no-wrap;
                overflow: elide;
            }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            path: Icons.open-in-new;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component AboutPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: Theme.gap;

            HorizontalLayout {
                spacing: 16px;
                AppLogo {
                    width: 56px;
                    height: 56px;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Genius LibreLinkUp";
                        font-size: 28px;
                        color: Theme.on-surface;
                    }
                    Caption {
                        text: @tr("Version {} · free software under the GNU GPL v3", About.version);
                        font-size: 13px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            SettingsSection {
                title: @tr("Open source on GitHub");
                subtitle: @tr("The code, the documentation and every release are public. Ideas, bug reports and pull requests are welcome.");
                VerticalLayout {
                    spacing: 2px;
                    LinkRow {
                        icon: Icons.code;
                        title: @tr("Source code");
                        subtitle: @tr("github.com/NUCL3ARN30N/genius-librelinkup");
                        clicked => { About.open-link(0); }
                    }
                    LinkRow {
                        icon: Icons.note;
                        title: @tr("Report a problem or suggest a feature");
                        subtitle: @tr("GitHub issues – please mention your version and operating system");
                        clicked => { About.open-link(1); }
                    }
                    LinkRow {
                        icon: Icons.refresh;
                        title: @tr("Releases & changelog");
                        subtitle: @tr("Downloads for Windows and Linux and what changed in each version");
                        clicked => { About.open-link(2); }
                    }
                    LinkRow {
                        icon: Icons.info;
                        title: @tr("Documentation");
                        subtitle: @tr("Features, reports, the caching server and where your data is stored");
                        clicked => { About.open-link(4); }
                    }
                    LinkRow {
                        icon: Icons.lock;
                        title: @tr("Licence");
                        subtitle: @tr("GNU General Public License v3.0");
                        clicked => { About.open-link(3); }
                    }
                }
            }

            if About.changes != "": SettingsSection {
                title: @tr("What's new in {}", About.version);
                Text {
                    text: About.changes;
                    color: Theme.on-surface;
                    wrap: word-wrap;
                }
            }

            SettingsSection {
                title: @tr("Disclaimer");
                Caption {
                    text: @tr("Genius LibreLinkUp is an unofficial tool and not affiliated with Abbott. It uses the undocumented LibreLinkUp API, which can change at any time. Never make treatment decisions based on this app – use your sensor reader or the official app.");
                    font-size: 13px;
                }
            }
        }
    }
}

component DevPage inherits Rectangle {
    property <int> selected: -1;
    VerticalLayout {
        padding: 24px;
        spacing: Theme.gap;
        PageHeader {
            title: @tr("API log");
            subtitle: @tr("Secrets and personal identifiers are redacted. File: {}", DevBridge.log-path);
            MButton {
                y: (parent.height - self.height) / 2;
                text: @tr("Open log folder");
                kind: 2;
                icon: Icons.folder;
                clicked => { DevBridge.open-log-folder(); }
            }
            MButton {
                y: (parent.height - self.height) / 2;
                text: @tr("Clear");
                kind: 3;
                clicked => {
                    root.selected = -1;
                    DevBridge.clear();
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;
            Card {
                width: 46%;
                ListView {
                    for e[i] in DevBridge.entries: Rectangle {
                        height: 52px;
                        background: root.selected == i ? Theme.primary-container : (ta.has-hover ? Theme.surface-container-high : transparent);
                        border-radius: Theme.radius-s;
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: e.ok ? Theme.target : Theme.low;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: e.title;
                                    color: Theme.on-surface;
                                    overflow: elide;
                                    font-size: 12px;
                                }
                                Caption {
                                    text: e.time + "  ·  " + e.status;
                                    wrap: no-wrap;
                                }
                            }
                        }
                        ta := TouchArea {
                            clicked => { root.selected = i; }
                        }
                    }
                }
            }
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 12px;
                    TextEdit {
                        vertical-stretch: 1;
                        read-only: true;
                        font-size: 12px;
                        text: root.selected >= 0 && root.selected < DevBridge.entries.length ? DevBridge.entries[root.selected].detail : @tr("Select a request (text can be selected and copied)");
                    }
                }
            }
        }
    }
}

component Overlay inherits Rectangle {
    background: Theme.scrim;
    TouchArea { }
    @children
}

component DialogCard inherits Card {
    in property <string> title;
    in property <string> icon;
    in property <bool> logo;
    tone: Theme.surface-container-high;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000050;
    VerticalLayout {
        padding: 28px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 12px;
            if root.logo: AppLogo {
                y: (parent.height - self.height) / 2;
            }
            if root.icon != "" && !root.logo: Icon {
                y: (parent.height - self.height) / 2;
                path: root.icon;
                tint: Theme.primary;
            }
            Text {
                text: root.title;
                font-size: 22px;
                color: Theme.on-surface;
                vertical-alignment: center;
            }
        }
        @children
    }
}

export component AppWindow inherits Window {
    title: "Genius LibreLinkUp";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1120px;
    preferred-height: 800px;
    min-width: 860px;
    min-height: 620px;
    background: Theme.background;
    default-font-size: 14px;

    in property <int> theme-mode;
    changed theme-mode => { self.apply-theme(); }
    init => { self.apply-theme(); }
    function apply-theme() {
        Palette.color-scheme = theme-mode == 1 ? ColorScheme.light : theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    in-out property <int> page;
    in property <bool> dev-mode;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> busy;

    // login
    in property <bool> logged-in;
    in property <bool> login-busy;
    in property <string> login-error;
    in property <string> login-email;
    in property <[string]> login-servers;
    callback login(string, string, bool, int);

    // pending legal step
    in property <string> step-text;
    callback accept-step();
    callback decline-step();

    // log unlock
    in property <bool> store-locked;
    in property <bool> store-new;
    in property <string> unlock-error;
    in property <bool> unlock-busy;
    callback unlock(string, bool);
    callback skip-unlock();

    callback refresh();

    HorizontalLayout {
        // navigation rail
        Rectangle {
            // wide enough for the German labels ("Einstellungen")
            width: 100px;
            background: Theme.surface;
            VerticalLayout {
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 12px;
                    AppLogo {
                        width: 36px;
                        height: 36px;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    NavItem {
                        icon: Icons.home;
                        label: @tr("Glucose");
                        selected: root.page == 0;
                        clicked => { root.page = 0; }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    NavItem {
                        icon: Icons.chart;
                        label: @tr("Reports");
                        selected: root.page == 1;
                        clicked => { root.page = 1; }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    NavItem {
                        icon: Icons.palette;
                        label: @tr("Appearance");
                        selected: root.page == 4;
                        clicked => { root.page = 4; }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    NavItem {
                        icon: Icons.settings;
                        label: @tr("Settings");
                        selected: root.page == 2;
                        clicked => { root.page = 2; }
                    }
                }
                if root.dev-mode: HorizontalLayout {
                    alignment: center;
                    NavItem {
                        icon: Icons.code;
                        label: @tr("API log");
                        selected: root.page == 3;
                        clicked => { root.page = 3; }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: center;
                    NavItem {
                        icon: Icons.info;
                        label: @tr("About");
                        selected: root.page == 5;
                        clicked => { root.page = 5; }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            if root.page == 0: DashboardPage {
                status: root.status;
                status-error: root.status-error;
                busy: root.busy;
                refresh => { root.refresh(); }
            }
            if root.page == 1: ReportsPage { }
            if root.page == 2: SettingsPage { }
            if root.page == 3: DevPage { }
            if root.page == 4: AppearancePage { }
            if root.page == 5: AboutPage { }
        }
    }

    property <bool> login-with-server;
    if !root.logged-in && root.login-with-server: Overlay {
        background: Theme.background;
        DialogCard {
            width: 460px;
            height: 360px;
            title: @tr("Connect to a caching server");
            logo: true;
            Caption {
                text: @tr("Run  gllu-server pair  on your server and paste the pairing code. This computer then reads all values from the server and needs no LibreLinkUp login.");
                font-size: 13px;
            }
            login-pair := TextField {
                label: @tr("Pairing code");
                placeholder: "gllu1:…";
            }
            if SyncBridge.status != "": Text {
                text: SyncBridge.status;
                color: SyncBridge.status-error ? Theme.error : Theme.on-surface-variant;
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                MButton {
                    text: @tr("Back");
                    kind: 3;
                    clicked => { root.login-with-server = false; }
                }
                Rectangle { horizontal-stretch: 1; }
                if SyncBridge.busy: Spinner {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    indeterminate: true;
                }
                MButton {
                    text: @tr("Pair");
                    kind: 0;
                    enabled: login-pair.text != "" && !SyncBridge.busy;
                    clicked => { SyncBridge.pair(login-pair.text, true); }
                }
            }
        }
    }

    if !root.logged-in && !root.login-with-server: Overlay {
        background: Theme.background;
        DialogCard {
            width: 440px;
            height: 500px;
            title: "Genius LibreLinkUp";
            logo: true;
            Caption {
                text: @tr("Sign in with your LibreLinkUp (follower) account.");
                font-size: 13px;
            }
            email := TextField {
                label: @tr("Email");
                text: root.login-email;
            }
            pw-edit := TextField {
                label: @tr("Password");
                input-type: password;
                accepted => { root.login(email.text, pw-edit.text, remember.checked, server.current-index); }
            }
            VerticalLayout {
                spacing: 4px;
                Caption { text: @tr("Server"); }
                server := ComboBox {
                    model: root.login-servers;
                    current-index: 0;
                }
            }
            remember := MSwitch {
                text: @tr("Remember password in the system keychain");
                checked: true;
            }
            if root.login-error != "": Banner { text: root.login-error; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 12px;
                MButton {
                    text: @tr("Use a caching server instead");
                    kind: 3;
                    clicked => { root.login-with-server = true; }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.login-busy: Spinner {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    indeterminate: true;
                }
                MButton {
                    text: @tr("Sign in");
                    kind: 0;
                    enabled: !root.login-busy && email.text != "" && pw-edit.text != "";
                    clicked => { root.login(email.text, pw-edit.text, remember.checked, server.current-index); }
                }
            }
        }
    }

    if root.logged-in && root.store-locked: Overlay {
        DialogCard {
            width: 460px;
            height: 340px;
            title: root.store-new ? @tr("Protect your glucose log") : @tr("Unlock your glucose log");
            icon: Icons.lock;
            Caption {
                text: root.store-new ? @tr("Choose a passphrase to encrypt the log files. Leave it empty to store them unencrypted.") : @tr("The log is encrypted. Enter the passphrase to load your history.");
                font-size: 13px;
            }
            pass := TextField {
                label: @tr("Passphrase");
                input-type: password;
                accepted => { root.unlock(pass.text, keep.checked); }
            }
            keep := MSwitch {
                text: @tr("Remember in the system keychain");
                checked: true;
            }
            if root.unlock-error != "": Banner { text: root.unlock-error; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                if root.unlock-busy: Spinner {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    indeterminate: true;
                }
                Rectangle { horizontal-stretch: 1; }
                MButton {
                    text: @tr("Continue without log");
                    kind: 3;
                    clicked => { root.skip-unlock(); }
                }
                MButton {
                    text: root.store-new ? @tr("Create") : @tr("Unlock");
                    kind: 0;
                    enabled: !root.unlock-busy && (root.store-new || pass.text != "");
                    clicked => { root.unlock(pass.text, keep.checked); }
                }
            }
        }
    }

    if Reports.detail-open: Overlay {
        TouchArea {
            clicked => { Reports.detail-open = false; }
        }
        Card {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 48px, 980px);
            height: min(parent.height - 48px, 680px);
            tone: Theme.surface-container-high;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            TouchArea { }
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        horizontal-stretch: 1;
                        text: Reports.detail-title;
                        font-size: 22px;
                        color: Theme.on-surface;
                        vertical-alignment: center;
                    }
                    if Notes.available: MButton {
                        y: (parent.height - self.height) / 2;
                        text: @tr("Add note");
                        kind: 3;
                        icon: Icons.note;
                        clicked => { Notes.compose(Reports.detail-date + " 12:00"); }
                    }
                    IconButton {
                        icon: Icons.chevron-left;
                        enabled: Reports.detail-prev >= 0;
                        clicked => { Reports.open-day(Reports.detail-prev); }
                    }
                    IconButton {
                        icon: Icons.chevron-right;
                        enabled: Reports.detail-next >= 0;
                        clicked => { Reports.open-day(Reports.detail-next); }
                    }
                    IconButton {
                        icon: Icons.close;
                        clicked => { Reports.detail-open = false; }
                    }
                }
                GlucoseGraph {
                    vertical-stretch: 1;
                    min-height: 220px;
                    graph-style: Dashboard.graph-style;
                    line-path: Reports.detail-line;
                    dots: Reports.detail-dots;
                    points: Reports.detail-points;
                    notes: Reports.detail-notes;
                    y-labels: Reports.detail-y-labels;
                    x-labels: Reports.detail-x-labels;
                    band-top: Reports.detail-band-top;
                    band-bottom: Reports.detail-band-bottom;
                    notes-enabled: Notes.available;
                    add-note(when) => { Notes.compose(when); }
                    edit-note(n) => { Notes.edit(n); }
                }
                HorizontalLayout {
                    spacing: 32px;
                    height: 200px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: space-between;
                        for s in Reports.detail-stats: HorizontalLayout {
                            spacing: 12px;
                            Text {
                                horizontal-stretch: 1;
                                text: s.label;
                                color: Theme.on-surface-variant;
                                vertical-alignment: center;
                            }
                            Text {
                                text: s.value;
                                color: Theme.on-surface;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    TirChart {
                        horizontal-stretch: 1;
                        rows: Reports.detail-tir;
                    }
                    VerticalLayout {
                        width: 280px;
                        spacing: 6px;
                        Title { text: @tr("Notes"); }
                        if Reports.detail-totals != "": Text {
                            text: Reports.detail-totals;
                            color: Theme.on-surface;
                            font-size: 13px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        if Reports.detail-notes.length == 0: Caption { text: Notes.available ? @tr("No notes on this day – click the graph to add one.") : @tr("No notes on this day."); }
                        ListView {
                            vertical-stretch: 1;
                            for n in Reports.detail-notes: Rectangle {
                                height: max(32px, row.preferred-height + 8px);
                                border-radius: Theme.radius-s;
                                background: note-touch.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent;
                                row := HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: Theme.note-color(n.kind);
                                    }
                                    Text {
                                        width: 40px;
                                        text: n.time;
                                        color: Theme.on-surface-variant;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: n.text;
                                        color: Theme.on-surface;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                                note-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Notes.edit(n); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if SettingsBridge.wipe-open: Overlay {
        DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 540px;
            height: 470px;
            title: @tr("Delete all local data?");
            icon: Icons.delete;
            Caption {
                text: @tr("This permanently removes from this computer:\n•  settings, app and API logs\n•  the saved LibreLinkUp sign-in, the log passphrase and the caching-server pairing (system keychain)\n•  the autostart entry");
                font-size: 13px;
            }
            wipe-log := MSwitch {
                text: @tr("Also delete the glucose log");
                supporting: @tr("{} – computers that sync this folder lose it too", SettingsBridge.log-folder);
                checked: true;
            }
            Caption {
                text: @tr("Export your readings first if you want to keep them. A paired caching server keeps listing this computer until you run  gllu-server revoke  there. The app closes when it is done.");
                font-size: 13px;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                MButton {
                    text: @tr("Cancel");
                    kind: 3;
                    clicked => { SettingsBridge.wipe-open = false; }
                }
                MButton {
                    text: @tr("Delete everything");
                    kind: 4;
                    icon: Icons.delete;
                    clicked => {
                        SettingsBridge.wipe-open = false;
                        SettingsBridge.wipe-data(wipe-log.checked);
                    }
                }
            }
        }
    }

    if Notes.open: Overlay {
        DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 580px;
            height: 420px + (Notes.treatment == 3 ? 70px : 0px) + (Notes.error != "" ? 60px : 0px);
            title: Notes.id == "" ? @tr("Add note") : @tr("Edit note");
            icon: Icons.note;
            init => { note-text.focus-input(); }
            note-text := TextField {
                label: @tr("Note");
                placeholder: @tr("e.g. pizza, 30 min walk");
                text <=> Notes.text;
                accepted => { if Notes.can-save { Notes.save(Notes.draft()); } }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Caption { text: @tr("Treatment"); }
                    ComboBox {
                        height: 44px;
                        model: Notes.treatments;
                        current-index <=> Notes.treatment;
                    }
                }
                // plain text: input-type decimal drops a typed comma ("4,5" became 45 u)
                TextField {
                    width: 100px;
                    label: @tr("Units");
                    placeholder: "4.5";
                    suffix: @tr("u");
                    enabled: Notes.treatment != 0;
                    text <=> Notes.units;
                    accepted => { if Notes.can-save { Notes.save(Notes.draft()); } }
                }
                TextField {
                    width: 100px;
                    label: @tr("Carbs");
                    placeholder: "45";
                    suffix: @tr("g");
                    text <=> Notes.carbs;
                    accepted => { if Notes.can-save { Notes.save(Notes.draft()); } }
                }
            }
            if Notes.treatment == 3: TextField {
                label: @tr("Custom treatment");
                placeholder: @tr("e.g. inhaled insulin, glucagon");
                text <=> Notes.treatment-name;
                accepted => { if Notes.can-save { Notes.save(Notes.draft()); } }
            }
            TextField {
                label: @tr("Time (YYYY-MM-DD HH:MM, or just HH:MM for today)");
                text <=> Notes.when;
                accepted => { if Notes.can-save { Notes.save(Notes.draft()); } }
            }
            if Notes.error != "": Banner { text: Notes.error; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                if Notes.id != "": MButton {
                    text: @tr("Delete");
                    kind: 3;
                    icon: Icons.delete;
                    clicked => { Notes.delete(Notes.id); }
                }
                Rectangle { horizontal-stretch: 1; }
                MButton {
                    text: @tr("Cancel");
                    kind: 3;
                    clicked => { Notes.open = false; }
                }
                MButton {
                    text: @tr("Save");
                    kind: 0;
                    icon: Icons.check;
                    enabled: Notes.can-save;
                    clicked => { Notes.save(Notes.draft()); }
                }
            }
        }
    }

    if ExportBridge.open: Overlay {
        DialogCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 560px;
            height: ExportBridge.error != "" ? 700px : 640px;
            title: @tr("Export glucose data");
            icon: Icons.download;
            Caption {
                text: @tr("A printable PDF report (statistics, AGP, daily profiles, notes) or the readings and notes as a CSV file – it opens in Excel or LibreOffice and can be imported here again.");
                font-size: 13px;
            }
            Segmented {
                options: [@tr("Last {} days", [7, 14, 30, 90][Reports.period-index]), @tr("All data")];
                selected <=> ExportBridge.range;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                MButton {
                    text: @tr("Save PDF…");
                    kind: 1;
                    icon: Icons.download;
                    enabled: !ExportBridge.busy;
                    clicked => { ExportBridge.save-pdf(ExportBridge.range); }
                }
                MButton {
                    text: @tr("Save CSV…");
                    kind: 1;
                    icon: Icons.download;
                    enabled: !ExportBridge.busy;
                    clicked => { ExportBridge.save-csv(ExportBridge.range); }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.outline-variant;
            }
            Title { text: @tr("Send by email"); }
            Caption {
                text: @tr("The data is packed into a ZIP file encrypted with AES-256 and attached to a new message in your mail program. Tell the recipient the password another way (phone, messenger) – the file opens with 7-Zip, WinRAR or Keka.");
                font-size: 13px;
            }
            HorizontalLayout {
                spacing: 12px;
                TextField {
                    horizontal-stretch: 1;
                    label: @tr("To (optional)");
                    placeholder: "doctor@example.com";
                    text <=> ExportBridge.recipient;
                }
                VerticalLayout {
                    width: 230px;
                    spacing: 4px;
                    Caption { text: @tr("Attach"); }
                    Segmented {
                        options: [@tr("CSV"), @tr("PDF"), @tr("Both")];
                        selected <=> ExportBridge.format;
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                TextField {
                    width: (parent.width - 12px) / 2;
                    label: @tr("Password (at least 8 characters)");
                    input-type: password;
                    text <=> ExportBridge.password;
                }
                TextField {
                    width: (parent.width - 12px) / 2;
                    label: @tr("Repeat password");
                    input-type: password;
                    text <=> ExportBridge.repeat;
                    accepted => { ExportBridge.send(ExportBridge.range, ExportBridge.format, ExportBridge.recipient, ExportBridge.password, ExportBridge.repeat); }
                }
            }
            if ExportBridge.error != "": Banner { text: ExportBridge.error; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                if ExportBridge.busy: Spinner {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    indeterminate: true;
                }
                Rectangle { horizontal-stretch: 1; }
                MButton {
                    text: @tr("Close");
                    kind: 3;
                    clicked => { ExportBridge.open = false; }
                }
                MButton {
                    text: @tr("Create email");
                    kind: 0;
                    icon: Icons.mail;
                    enabled: !ExportBridge.busy && ExportBridge.password != "";
                    clicked => { ExportBridge.send(ExportBridge.range, ExportBridge.format, ExportBridge.recipient, ExportBridge.password, ExportBridge.repeat); }
                }
            }
        }
    }

    if root.step-text != "": Overlay {
        DialogCard {
            width: 480px;
            height: 270px;
            title: @tr("Action required by LibreLinkUp");
            Caption {
                text: root.step-text;
                font-size: 13px;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                MButton {
                    text: @tr("Cancel");
                    kind: 3;
                    clicked => { root.decline-step(); }
                }
                MButton {
                    text: @tr("I accept");
                    kind: 0;
                    clicked => { root.accept-step(); }
                }
            }
        }
    }

    Snackbar {
        x: (parent.width - self.width) / 2 + 50px;
        y: parent.height - self.height - 24px;
    }
}
