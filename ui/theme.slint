import { Palette } from "std-widgets.slint";

// Material 3 inspired tokens derived from a user-selectable accent colour, light + dark.
// Everything marked in-out is set from Rust (Settings → Appearance).
export global Theme {
    // Follow whatever scheme the Material widgets resolved (system, or forced light/dark).
    out property <bool> dark: Palette.foreground.to-hsv().value > 0.5;

    in-out property <color> accent: #1d5fa8;
    // true when black text reads better on the accent (computed in Rust)
    in-out property <bool> accent-is-light: false;
    // 0 square, 1 rounded, 2 round
    in-out property <int> corners: 1;

    out property <color> background: dark ? accent.mix(#111318, 0.04) : accent.mix(#fafbff, 0.03);
    out property <color> surface: dark ? accent.mix(#1a1c21, 0.04) : #ffffff;
    out property <color> surface-container: dark ? accent.mix(#1f2228, 0.06) : accent.mix(#eff1f6, 0.05);
    out property <color> surface-container-high: dark ? accent.mix(#2a2d34, 0.07) : accent.mix(#e4e7ee, 0.07);
    out property <color> on-surface: dark ? #e3e3e8 : #191c20;
    out property <color> on-surface-variant: dark ? #c2c6cf : #44474e;
    out property <color> outline: dark ? #8d9199 : #74777f;
    out property <color> outline-variant: dark ? #43474e : #c4c6cf;
    out property <color> primary: dark ? accent.mix(#ffffff, 0.55) : accent;
    out property <color> on-primary: dark ? accent.mix(#000000, 0.3) : (accent-is-light ? #000000 : #ffffff);
    out property <color> primary-container: dark ? accent.mix(#15171c, 0.42) : accent.mix(#ffffff, 0.18);
    out property <color> on-primary-container: dark ? accent.mix(#ffffff, 0.15) : accent.mix(#000000, 0.45);
    out property <color> error: dark ? #ffb4ab : #ba1a1a;
    out property <color> on-error: dark ? #690005 : #ffffff;
    out property <color> error-container: dark ? #93000a : #ffdad6;
    out property <color> on-error-container: dark ? #ffdad6 : #410002;
    out property <color> inverse-surface: dark ? #e3e3e8 : #2e3036;
    out property <color> inverse-on-surface: dark ? #2e3036 : #f0f0f6;
    out property <color> scrim: #000000a0;

    // Glucose range colours (LibreView convention by default)
    in-out property <color> very-low: #8e0e0e;
    in-out property <color> low: #d32f2f;
    in-out property <color> target: #2e7d32;
    in-out property <color> high: #f9a825;
    in-out property <color> very-high: #ef6c00;
    out property <color> unknown: #757575;
    out property <color> target-band: target.with-alpha(dark ? 0.22 : 0.14);
    out property <color> grid: dark ? #ffffff14 : #00000012;
    out property <color> agp-outer: primary.with-alpha(0.25);
    out property <color> agp-inner: primary.with-alpha(0.55);
    out property <color> agp-median: dark ? primary.mix(#ffffff, 0.6) : primary.mix(#000000, 0.6);

    // level: 0 unknown, 1 very low, 2 low, 3 target, 4 high, 5 very high
    public pure function level-color(level: int) -> color {
        if level == 1 { return very-low; }
        if level == 2 { return low; }
        if level == 3 { return target; }
        if level == 4 { return high; }
        if level == 5 { return very-high; }
        return unknown;
    }

    // light: 0 none, 1 green, 2 yellow, 3 red
    public pure function light-color(light: int) -> color {
        if light == 1 { return #43a047; }
        if light == 2 { return #f9c623; }
        if light == 3 { return #e53935; }
        return outline-variant;
    }

    out property <length> radius-l: corners == 0 ? 6px : corners == 1 ? 20px : 28px;
    out property <length> radius-m: corners == 0 ? 4px : corners == 1 ? 10px : 16px;
    out property <length> radius-s: corners == 0 ? 3px : corners == 1 ? 8px : 12px;
    // buttons and chips: pill unless square corners are chosen
    out property <length> radius-pill: corners == 0 ? 6px : 999px;
    out property <length> gap: 16px;
}

// Transient messages ("Saved", errors) shown as a snackbar that hides itself.
export global Toast {
    in-out property <string> message;
}

// Material Symbols (Apache 2.0) path data, 24×24 viewbox
export global Icons {
    out property <string> home: "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z";
    out property <string> chart: "M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z";
    out property <string> settings: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
    out property <string> code: "M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z";
    out property <string> refresh: "M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z";
    // same silhouette as the application icon (src/icon.rs): tip, tangents, round body
    out property <string> drop: "M12 .5L18.98 8.77A9.12 9.12 0 1 1 5.02 8.77Z";
    out property <string> pulse: "M7.2 16.3H10.1L12 12.5L13.9 19.2L15.4 15.8H17.3";
    out property <string> lock: "M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z";
    out property <string> sensor: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-13c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5z";
    out property <string> folder: "M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z";
    out property <string> palette: "M12 3a9 9 0 0 0 0 18c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z";
    out property <string> minus: "M19 13H5v-2h14v2z";
    out property <string> chevron-left: "M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z";
    out property <string> chevron-right: "M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z";
    out property <string> delete: "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z";
    out property <string> close: "M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
    out property <string> plus: "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z";
    out property <string> check: "M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z";
    // trend arrows, index 1 (falling fast) … 5 (rising fast)
    public pure function trend(i: int) -> string {
        if i == 1 { return "M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"; }
        if i == 2 { return "M19 9h-2v6.59L5.41 4 4 5.41 15.59 17H9v2h10z"; }
        if i == 3 { return "M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"; }
        if i == 4 { return "M9 5v2h6.59L4 18.59 5.41 20 17 8.41V15h2V5z"; }
        if i == 5 { return "M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z"; }
        return "";
    }
}
